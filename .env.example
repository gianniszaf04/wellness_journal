#DB Config
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
#Για το database/migrate.php, χρειάζεται ALTER/CREATE. Κενό = ίδιος χρήστης με το DB_USER
#MIGRATE_DB_USER=root
#MIGRATE_DB_PASS=

#App Config
#Το αφήνουμε κενό για αυτόματη ανίχνευση της διαδρομής
#Ή ορίζουμε APP_URL=http://localhost/wellness_journal

APP_URL=

APP_ENV=
APP_DEBUG=
#Ζώνη ώρας για PHP και MySQL, κενό = Europe/Athens
APP_TIMEZONE=

#Mail Config
#Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_PASSWORD = app password (myaccount.google.com/apppasswords)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
#Κενό = ίδιο με το MAIL_USERNAME
MAIL_FROM=
MAIL_FROM_NAME="Wellness Journal"

#AI Config

AI_SERVICE_URL=
AI_SERVICE_TIMEOUT=
#1 = στελνει τα κειμενα στο OpenAI για επαληθευση (θελει και OPENAI_API_KEY). 0 = κλειστο
OPENAI_VERIFY=0
#1 = κραταει και τα αποτελεσματα του ανεκπαιδευτου μοντελου (τυχαια), μονο για δοκιμες της ροης. 0 = κλειστο
AI_ALLOW_UNTRAINED=0

#SENTIMENT THRESHOLDS FOR INSIGHTS
SENTIMENT_WARNING_THRESHOLD=
SENTIMENT_IMPROVEMENT_THRESHOLD=

#Πιθανότητα κινδύνου (risk head) από την οποία εμφανίζονται οι γραμμές βοήθειας, κενό = 0.3
CRISIS_RISK_THRESHOLD=
